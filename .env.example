# 默认只供本机访问。修改为 0.0.0.0 时必须设置 WANXIANG_PASSWORD。
HOST=127.0.0.1
PORT=3000

# 可选：在网页「AI 服务设置」中填写，或使用服务端环境变量（二选一）。
# WANXIANG_AI_KEY=在本机填写真实密钥，切勿提交此文件中的密钥
# OPENAI_BASE_URL=https://api.openai.com/v1

# 对外访问必须设置强密码，并使用 HTTPS 反向代理。
# WANXIANG_PASSWORD=请自行设置工作室访问密码

# 可选：私有项目、素材与设置的保存位置，默认项目根目录 .data
# WANXIANG_DATA_DIR=/absolute/path/to/private-data
